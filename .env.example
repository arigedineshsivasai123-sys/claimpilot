# ==========================================
# CLAIMPILOT ROOT CONFIGURATION TEMPLATE
# (See server/.env.example and client/.env.example for details)
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/claimpilot

# Authentication
JWT_SECRET=claimpilot_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Multi-Agent Decision Thresholds
AI_CONFIDENCE_THRESHOLD=0.80
HIGH_VALUE_CLAIM_THRESHOLD=500000

# Client Configuration
VITE_API_URL=http://localhost:5000/api
